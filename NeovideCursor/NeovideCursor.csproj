<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>10.0</LangVersion>
    <RootNamespace>NeovideCursor</RootNamespace>
    <AssemblyName>NeovideCursor</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <!-- Tells Visual Studio this is a VSIX extension project (rather than a plain
         class library), so F5 deploys the VSIX to the Experimental instance and
         launches devenv.exe /RootSuffix Exp instead of refusing to start the
         library. msbuild ignores this property; it only affects the VS project
         system. -->
    <ProjectTypeGuids>{82b43b9b-a64c-4715-b499-d71e9ca2bd60};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
  </PropertyGroup>

  <!--
    Reference assemblies are resolved from the local Visual Studio installation.
    Override with -p:VSPath="<YourVSInstallPath>" if your VS is installed elsewhere.
  -->
  <PropertyGroup>
    <VSPath Condition="'$(VSPath)'==''">F:\VisualStudio</VSPath>
    <VSEditorPath>$(VSPath)\Common7\IDE\CommonExtensions\Microsoft\Editor</VSEditorPath>
    <VSPublicPath>$(VSPath)\Common7\IDE\PublicAssemblies</VSPublicPath>
  </PropertyGroup>

  <!--
    F5 (Debug → Start): the VSIX project flavor's deploy step installs the VSIX
    into the Experimental instance, but the "start" step defaults to running the
    project output — a class library — which is why Visual Studio reports "cannot
    directly start a project with a class-library output type". Point it at
    devenv.exe /RootSuffix Exp so F5 launches the Experimental instance with the
    deployed extension loaded. (ProjectTypeGuids makes the flavor deploy the VSIX;
    these properties tell it what to launch.)
  -->
  <PropertyGroup Condition="'$(BuildingInsideVisualStudio)'=='true'">
    <StartAction>Program</StartAction>
    <StartProgram>$(VSPath)\Common7\IDE\devenv.exe</StartProgram>
    <StartArguments>/RootSuffix Exp</StartArguments>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="Microsoft.VisualStudio.Interop">
      <HintPath>$(VSPublicPath)\Microsoft.VisualStudio.Interop.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.CoreUtility">
      <HintPath>$(VSEditorPath)\Microsoft.VisualStudio.CoreUtility.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.Text.Data">
      <HintPath>$(VSEditorPath)\Microsoft.VisualStudio.Text.Data.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.Text.Logic">
      <HintPath>$(VSEditorPath)\Microsoft.VisualStudio.Text.Logic.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.Text.UI">
      <HintPath>$(VSEditorPath)\Microsoft.VisualStudio.Text.UI.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.Text.UI.Wpf">
      <HintPath>$(VSEditorPath)\Microsoft.VisualStudio.Text.UI.Wpf.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.Shell.15.0">
      <HintPath>$(VSPublicPath)\Microsoft.VisualStudio.Shell.15.0.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.Shell.Framework">
      <HintPath>$(VSPublicPath)\Microsoft.VisualStudio.Shell.Framework.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.Shell.Interop">
      <HintPath>$(VSPublicPath)\Microsoft.VisualStudio.Shell.Interop.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.Shell.Interop.8.0">
      <HintPath>$(VSPublicPath)\Microsoft.VisualStudio.Shell.Interop.8.0.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.Threading">
      <HintPath>$(VSPublicPath)\Microsoft.VisualStudio.Threading.17.x\Microsoft.VisualStudio.Threading.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!--
    VSIX packaging.

    Active whenever the project is built inside Visual Studio (Build / F5 — the
    normal way to produce a .vsix and deploy to the Experimental instance), or
    from the command line with:  dotnet build -p:BuildVsix=true

    Requires the "Visual Studio extension development" workload (installed VSSDK)
    or, for command-line builds, the Microsoft.VSSDK.BuildTools NuGet package
    (restored from nuget.org).
  -->
  <PropertyGroup Condition="'$(BuildVsix)'=='true' Or '$(BuildingInsideVisualStudio)'=='true'">
    <IsVsixProject>true</IsVsixProject>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <!-- CreatePkgDef only writes the CodeBase entry (needed for CLR to locate the
         package assembly inside the VSIX package folder) when RegisterWithCodebase
         is true; without it the package registers Assembly-only and fails to load
         with FileNotFoundException. -->
    <RegisterWithCodebase>true</RegisterWithCodebase>
    <CreateVsixContainer>true</CreateVsixContainer>
    <VSSDKTargetPlatformRegRootSuffix>Exp</VSSDKTargetPlatformRegRootSuffix>
    <!-- VSServices.GetService pattern mirrors Smooth Caret's proven code; the
         services are guaranteed present once the package is initialized. -->
    <NoWarn>$(NoWarn);VSSDK006</NoWarn>
    <!-- dotnet build errors out with "VSIX deployment is not supported" if
         DeployExtension=true, so only deploy from inside Visual Studio (Debug /
         F5 installs to the Experimental instance). -->
    <DeployExtension Condition="'$(BuildingInsideVisualStudio)'!='true'">false</DeployExtension>
    <DeployExtension Condition="'$(BuildingInsideVisualStudio)'=='true' And '$(Configuration)'=='Debug'">true</DeployExtension>
    <!-- IntermediateOutputPath is not set yet when this PropertyGroup is evaluated in an
         SDK-style project, so give the VSSDK template-manifest step a concrete directory. -->
    <TemplateOutputDirectory>$(MSBuildProjectDirectory)\obj\$(Configuration)\template-output</TemplateOutputDirectory>
    <!-- The VSSDK targets are imported before the SDK's own targets have run, so
         $(OutDir)/$(IntermediateOutputPath) are empty when it computes these and it
         produces paths like "\NeovideCursor\.vsix" that break both the container
         creation and the Visual Studio deploy pass (which reads TargetVsixContainer
         via VSIXContainerProjectOutputGroup in a separate msbuild invocation). Pin
         them to the concrete SDK output layout. -->
    <TargetVsixContainer>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).vsix</TargetVsixContainer>
    <IntermediateVsixManifest>$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\extension.vsixmanifest</IntermediateVsixManifest>
  </PropertyGroup>

  <ItemGroup Condition="'$(BuildVsix)'=='true' Or '$(BuildingInsideVisualStudio)'=='true'">
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.14.2094" PrivateAssets="all" />
  </ItemGroup>

  <!--
    In an SDK-style project the VSSDK targets are imported before the SDK's own
    targets, so $(TargetPath) is not available yet when the VSSDK defaults are
    evaluated. Assign it at execution time, right before GeneratePkgDef consumes it.
    (TargetVsixContainer / IntermediateVsixManifest are already pinned at evaluation
    time above so the deploy pass sees the same concrete paths.)
  -->
  <Target Name="AssignVsixPaths" BeforeTargets="GeneratePkgDef">
    <PropertyGroup>
      <CreatePkgDefAssemblyToProcess Condition="'$(TargetPath)'!=''">$(TargetPath)</CreatePkgDefAssemblyToProcess>
      <CreatePkgDefAssemblyToProcess Condition="'$(TargetPath)'==''">$(TargetDir)$(TargetFileName)</CreatePkgDefAssemblyToProcess>
    </PropertyGroup>
  </Target>

  <!--
    The VSSDK wires CreateVsixContainer into the build pipeline through
    PrepareForRunDependsOn, but an SDK-style project's PrepareForRun target does
    not honor that extension point (it is expanded before this import). Re-hook
    the full container chain after Build so a plain Build produces the .vsix.
  -->
  <Target Name="RunVsixContainer" AfterTargets="Build"
          Condition="'$(CreateVsixContainer)'=='true'"
          DependsOnTargets="AssignVsixPaths;GeneratePkgDef;CopyPkgDef;CreateVsixContainer;CopyVsixManifestFile;CopyVsixExtensionFiles" />

  <!--
    SDK-style projects do not auto-import the VSSDK targets; import them
    explicitly to enable VSIX container / pkgdef generation. (In the CLI case the
    NuGet package above supplies $(VSToolsPath); inside VS the extension
    development workload supplies it. If neither is present the project simply
    builds as a plain class library.)
  -->
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets"
          Condition="('$(BuildVsix)'=='true' Or '$(BuildingInsideVisualStudio)'=='true') And Exists('$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets')" />
</Project>
