<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011">
  <Metadata>
    <Identity Id="NeovideCursor.4f43b2d1-0c53-4e4b-9a2d-7c1b5e8f2a91" Version="1.0" Language="en-US" Publisher="Neovide Cursor" />
    <DisplayName>Neovide Cursor</DisplayName>
    <Description xml:space="preserve">Neovide-style smooth animated cursor for the Visual Studio text editor, ported from the neovide-cursor VS Code extension using Smooth Caret's integration approach.</Description>
    <MoreInfo>https://github.com/neovide/neovide</MoreInfo>
    <Tags>caret;cursor;animation;neovide;smooth;spring</Tags>
  </Metadata>
  <Installation InstalledByMsi="false" AllUsers="false">
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0, 19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Professional" Version="[17.0, 19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Enterprise" Version="[17.0, 19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" Version="[4.6,)" />
  </Dependencies>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.0,19.0)" DisplayName="Visual Studio core editor" />
  </Prerequisites>
  <Assets>
    <!-- MEF component: the editor integration (IWpfTextViewCreationListener,
         AdornmentLayerDefinition) is exported via MEF and must be discoverable. -->
    <Asset Type="Microsoft.VisualStudio.MefComponent" Path="NeovideCursor.dll" />
    <Asset Type="Microsoft.VisualStudio.VsPackage" Path="NeovideCursor.pkgdef" />
  </Assets>
</PackageManifest>